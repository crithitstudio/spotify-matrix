{
  "acts": [
    {
      "index": 1, "title": "23:02 — HALCYON COURT", "clock": "23:00",
      "ambient": 1.0, "interval": 55, "witnessCap": 0,
      "beats": [
        { "id": "a1_open", "trigger": "actstart", "do": [
          "sub:Night shift. Three weeks until they tear this place down.",
          "cue:2.5:voice:voice_super_1:\"Machine's for you. Day man quit. Note's on the desk — follow it, lock up after your rounds. Don't call unless the building's on fire.\"",
          "task:add:signin:Read the handover note (Security office)",
          "cue:6:sub:The clipboard is on your belt. [Tab]"
        ]},
        { "id": "a1_note", "trigger": "doc_read", "arg": "handover_note", "do": [
          "task:done:signin",
          "task:add:laundry:Shut off the running washer (Laundry)",
          "task:add:inspect1a:Photograph the vacancy damage in 1A — key is on the board",
          "sub:Keys hang by the shelf. The camera is in your jacket. [C]"
        ]},
        { "id": "a1_laundrydone", "trigger": "action", "arg": "laundry_stop", "do": [
          "task:done:laundry", "snd:switch_click",
          "sub:The drum spins down. The quiet is worse.",
          "cue:8:sndat:pipe_knock:boiler_hall"
        ]},
        { "id": "a1_key", "trigger": "pickup", "arg": "key_1a", "do": [
          "sub:1A. Second floor... no. First. It's the first floor."
        ]},
        { "id": "a1_enter1a", "trigger": "enter", "arg": "apt_1A", "do": [
          "sub:Dust sheets. They left the TV.",
          "cue:14:snd:tv_static", "cue:14.2:prop:a1_tv:tex:plaster"
        ]},
        { "id": "a1_stain", "trigger": "action", "arg": "inspect_stain", "do": [
          "sub:Water damage. That shape wasn't in the day man's report."
        ]},
        { "id": "a1_photo", "trigger": "photo", "do": [
          "task:done:inspect1a",
          "sub:One for the file.",
          "cue:3:event:ev_writing_1a"
        ]},
        { "id": "a1_mug", "trigger": "time", "at": 4, "do": [ "event:ev_mug" ]},
        { "id": "a1_creak", "trigger": "time", "at": 7, "do": [ "event:ev_creak_lobby" ]},
        { "id": "a1_phone", "trigger": "task_done", "arg": "inspect1a", "do": [
          "cue:10:event:ev_phone_first"
        ]},
        { "id": "a1_answer", "trigger": "phone", "arg": "answered", "do": [
          "voice:voice_super_2:\"You settling in? Cameras still work, mostly. Log your round at the desk and stop wandering. Place plays tricks when it's empty.\"",
          "task:add:loground:Log the round on the security monitors"
        ]},
        { "id": "a1_monitor", "trigger": "monitor", "arg": "main", "do": [
          "task:done:loground",
          "sub:Eight cameras. Eight empty rooms.",
          "cue:6:snd:static_burst",
          "cue:14:act:2"
        ]},
        { "id": "a1_tv", "trigger": "action", "arg": "tv_1a", "do": [
          "snd:tv_static", "sub:Unplugged. Of course it is."
        ]}
      ]
    },
    {
      "index": 2, "title": "00:31", "clock": "00:31",
